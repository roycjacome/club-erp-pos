# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================================

# Tipo de base de datos: CLOUDSQL o FIRESTORE
DATABASE_TYPE=CLOUDSQL

# Configuración para Cloud SQL (PostgreSQL o MySQL)
# Reemplaza los valores con tus credenciales reales
DB_HOST=your_database_host_or_ip
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=ccc_playa_palmas

# Configuración para Firestore (descomenta si usas Firestore)
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================================

# Puerto en el que escucha el servidor (por defecto 3000)
# En Google Cloud Run, asegúrate de que sea 8080
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# ============================================================================
# CONFIGURACIÓN DEL CLIENTE
# ============================================================================

# URL base de la API (para desarrollo local)
VITE_API_BASE_URL=http://localhost:3000

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
# 1. Para Cloud SQL:
#    - Asegúrate de que el usuario de la base de datos tenga permisos para crear tablas
#    - Las tablas se crearán automáticamente en el primer inicio
#
# 2. Para Firestore:
#    - Descarga tu archivo de credenciales JSON desde Google Cloud Console
#    - Asegúrate de que GOOGLE_APPLICATION_CREDENTIALS apunte al archivo correcto
#
# 3. En Google Cloud Run:
#    - Usa Cloud SQL Proxy o Cloud SQL Connector para conectarte a Cloud SQL
#    - Para Firestore, asegúrate de que el servicio tiene permisos de Firestore
